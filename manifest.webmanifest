  "description": "Tài chính, lịch âm dương, sức khỏe, học tập, kế hoạch – dùng được cả khi không có mạng.",
  "lang": "vi",
  "id": "./",
  "start_url": "./#tong-quan",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f4f5fb",
  "theme_color": "#1e2a5e",
  "categories": ["finance", "productivity", "lifestyle"],
  "share_target": { "action": "./share-target", "method": "POST", "enctype": "multipart/form-data", "params": { "title": "title", "text": "text", "files": [{ "name": "image", "accept": ["image/*"] }] } },
  "icons": [
    { "src": "icons/icon-192.png?v=1.13.1", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png?v=1.13.1", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png?v=1.13.1", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png?v=1.13.1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Thêm thu chi", "url": "./#thu-chi", "icons": [{ "src": "icons/icon-192.png?v=1.13.1", "sizes": "192x192" }] },
    { "name": "Lịch & nhắc nhở", "url": "./#nhac-nho", "icons": [{ "src": "icons/icon-192.png?v=1.13.1", "sizes": "192x192" }] }
  ]
}
