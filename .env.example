# Sổ Cá Nhân – biến môi trường (đặt trên Railway › Variables). KHÔNG commit file .env thật.
# Giá trị dưới đây là MẪU – thay bằng giá trị thật trên Railway, không dùng nguyên.

# --- Bắt buộc ---
SYNC_TOKEN=            # mã đồng bộ (chuỗi dài, ngẫu nhiên). Dùng khi tạo tài khoản chủ
DATABASE_URL=          # Postgres trên Railway (tự liên kết từ dịch vụ Postgres)

# --- Khôi phục mật khẩu ---
BACKUP_TOKEN=          # mã khôi phục khi quên mật khẩu (có biến này → chỉ nhận mã này)

# --- WebAuthn / Passkey (Face ID / Touch ID / vân tay) ---
# Mặc định lấy theo RAILWAY_PUBLIC_DOMAIN (Railway tự đặt). Chỉ đặt khi dùng tên miền riêng.
# Đổi RP_ID sau khi đã đăng ký passkey → passkey cũ KHÔNG dùng được nữa (phải bật lại).
RP_ID=                 # VD: sotaycanhan-production.up.railway.app (chỉ tên miền, không https://, không cổng, không đường dẫn)
ORIGIN=                # VD: https://sotaycanhan-production.up.railway.app (tên cũ RP_ORIGIN vẫn dùng được)
RP_NAME=               # tên hiển thị trong hộp thoại passkey, mặc định "Sổ Cá Nhân"
BIO_BIND=1             # 1 (mặc định) = passkey GẮN MÁY: chỉ dùng trên đúng máy đã bật · 0 = cho passkey đồng bộ iCloud/Google dùng trên mọi máy
BIO_DEVICE_ONLY=0      # 1 = chỉ nhận khoá 1 thiết bị (không nhận passkey đồng bộ – iPhone/Android không bật được)
CHALLENGE_TTL_SEC=300  # hạn dùng challenge WebAuthn (giây)
STEPUP_SEC=300         # thời gian hiệu lực xác thực lại trước thao tác nhạy cảm (giây)

# --- Tuỳ chọn khác ---
ALLOW_ORIGIN=          # ĐỂ TRỐNG (khuyên dùng): app & API cùng tên miền → chặn mọi trang khác gọi API. Chỉ đặt 1 nguồn khi tách tên miền.
                       # Lưu ý: máy chủ KHÔNG đọc biến ALLOWED_ORIGINS (tên cũ) – có cũng không tác dụng
GITHUB_TOKEN=          # sao lưu dữ liệu mã hoá lên GitHub hằng tuần (cùng BACKUP_KEY / BACKUP_BRANCH)
BACKUP_KEY=            # khoá mã hoá bản sao lưu GitHub (khác BACKUP_TOKEN)
